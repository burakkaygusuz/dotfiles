[user]
	name = Burak Kaygusuz

# Keep private identity details out of the public repo.
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main
[core]
	excludesfile = ~/.gitignore_global
	editor = code --wait
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	fsmonitor = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
	followTags = true
[diff]
	tool = vscode
	algorithm = histogram
	mnemonicPrefix = true
	renames = true
	colorMoved = default
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[merge]
	tool = vscode
	conflictstyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[help]
	autocorrect = prompt
[color]
	ui = auto
[gpg]
	format = ssh
[column]
	ui = auto
[branch]
	sort = -committerdate
[gc]
	writeCommitGraph = true
[rerere]
	enabled = true
	autoUpdate = true
