# Deduplicate PATH automatically in Zsh
typeset -U path PATH

# Homebrew environment & telemetry opt-out
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_AUTO_UPDATE_SECS=86400
export HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS=1

# Homebrew initialization (Apple Silicon)
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# PNPM Configuration
export PNPM_HOME="$HOME/Library/pnpm"

# Canonical PATH hierarchy (.local/bin > pnpm > homebrew > system)
path=(
    "$HOME/.local/bin"
    "$PNPM_HOME"
    $path
)
export PATH

# ------------------------------------------------------------------------------
# SHELL INTEGRATIONS & SECRETS
# ------------------------------------------------------------------------------
# Load local secrets (key=value parser — no arbitrary code execution)
if [ -f ~/.secrets.env ]; then
    () {
        local line key val
        while IFS= read -r line || [ -n "$line" ]; do
            # skip comments and blank lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// }" ]] && continue
            # strip optional leading "export "
            line="${line#export }"
            # extract key and value
            key="${line%%=*}"
            key="${key// }"
            val="${line#*=}"
            val="${val#"${val%%[! ]*}"}"
            val="${val%"${val##*[! ]}"}"
            # only export valid identifiers
            if [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                val="${val#\'}"; val="${val%\'}"
                val="${val#\"}"; val="${val%\"}"
                export "$key=$val"
            fi
        done < ~/.secrets.env
    }
fi

# ------------------------------------------------------------------------------
# SHELL BEHAVIOR & CONFIGURATION
# ------------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt AUTO_CD

# Completion (cached — rebuilds once per day)
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

# Prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# ------------------------------------------------------------------------------
# PRIVACY & TELEMETRY (Opt-out)
# ------------------------------------------------------------------------------
export VSCODE_CLI_TELEMETRY_OPTOUT=1
export SHELL_SESSIONS_DISABLE=1
export PYTHON_HISTORY=/dev/null
export PYTHONSTARTUP="/dev/null"

# ------------------------------------------------------------------------------
# ALIASES
# ------------------------------------------------------------------------------
alias ..='cd ..'
alias ll='ls -lahG'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate --all'
alias py='python3'
alias node='node --no-warnings'

# Modern CLI tools in interactive sessions
command -v bfs >/dev/null 2>&1 && alias find='bfs'
if command -v ugrep >/dev/null 2>&1; then
    alias grep='ugrep'
    alias egrep='ugrep -E'
    alias fgrep='ugrep -F'
fi
