[user]
	name = Burak Kaygusuz
	email = {{ .email }}
{{- if stat (joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub") }}
	signingkey = {{ joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" }}
{{- end }}

[init]
	defaultBranch = main
[core]
	excludesfile = ~/.gitignore_global
	editor = code --wait
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	fsmonitor = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
	followTags = true
[diff]
	tool = vscode
	algorithm = histogram
	mnemonicPrefix = true
	renames = true
	colorMoved = default
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[merge]
	tool = vscode
	conflictstyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[help]
	autocorrect = prompt
[color]
	ui = auto
[gpg]
	format = ssh
{{- if stat (joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub") }}
[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".ssh/allowed_signers" }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
[column]
	ui = auto
[branch]
	sort = -committerdate
[gc]
	writeCommitGraph = true
[rerere]
	enabled = true
	autoUpdate = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
