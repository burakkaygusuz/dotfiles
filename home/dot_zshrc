# Deduplicate PATH automatically in Zsh
typeset -U path PATH

# Homebrew initialization (Apple Silicon)
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Canonical PATH hierarchy (.local/bin > pnpm > homebrew > system)
path=(
    "$HOME/.local/bin"
    "$PNPM_HOME"
    "/opt/homebrew/opt/python@3.14/libexec/bin"
    $path
)
export PATH

# ------------------------------------------------------------------------------
# SHELL INTEGRATIONS & SECRETS
# ------------------------------------------------------------------------------
# Load local secrets (key=value parser — no arbitrary code execution)
if [ -f ~/.secrets.env ]; then
    () {
        local line key val
        while IFS= read -r line || [ -n "$line" ]; do
            # skip comments and blank lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// }" ]] && continue
            # strip optional leading "export "
            line="${line#export }"
            # extract key and value
            key="${line%%=*}"
            key="${key// }"
            val="${line#*=}"
            val="${val#"${val%%[! ]*}"}"
            val="${val%"${val##*[! ]}"}"
            # only export valid identifiers
            if [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                val="${val#\'}"; val="${val%\'}"
                val="${val#\"}"; val="${val%\"}"
                export "$key=$val"
            fi
        done < ~/.secrets.env
    }
fi

# ------------------------------------------------------------------------------
# SHELL BEHAVIOR & CONFIGURATION
# ------------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt AUTO_CD

# Completion (cached — rebuilds once per day)
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

# Window title (current directory basename)
function set_win_title() {
    echo -ne "\033]0; ${PWD:t} \007"
}
precmd_functions+=(set_win_title)

# Prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Shared aliases (see ~/.config/shell)
source ~/.config/shell/aliases.sh
