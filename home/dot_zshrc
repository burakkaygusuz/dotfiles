# Deduplicate PATH automatically in Zsh
typeset -U path PATH

# Homebrew initialization (Apple Silicon)
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Canonical PATH hierarchy (.local/bin > pnpm > python > homebrew > system)
path=(
    "$HOME/.local/bin"
    "$PNPM_HOME"
    "/opt/homebrew/opt/python@3.15/libexec/bin"
    $path
)
export PATH

# ------------------------------------------------------------------------------
# SHELL BEHAVIOR & CONFIGURATION
# ------------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_EXPIRE_DUPS_FIRST
setopt AUTO_CD

# Completion (cached — rebuilds once per day)
autoload -Uz compinit
zcompdump_stale=(~/.zcompdump(N.mh+24))
if (( ${#zcompdump_stale} )) || [[ ! -e ~/.zcompdump ]]; then
    compinit
else
    compinit -C
fi

# Prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# Shared aliases (see ~/.config/shell)
source ~/.config/shell/aliases.sh
