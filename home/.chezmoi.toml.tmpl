{{- if or (ne .chezmoi.os "darwin") (ne .chezmoi.arch "arm64") -}}
{{- fail "This repository supports Apple Silicon macOS only." -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    email = {{ promptStringOnce . "email" "Git email (also the SSH key label)" | quote }}
    secretNames = {{ promptStringOnce . "secretNames" "Keychain secret names, space-separated (may be empty)" | quote }}
