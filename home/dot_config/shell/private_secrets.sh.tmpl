{{- $names := without (splitList " " .secretNames) "" -}}
{{- range $names -}}
{{- if not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" .) -}}
{{- fail (printf "invalid secret name %q in secretNames: use letters, digits and _ only, not starting with a digit" .) -}}
{{- end -}}
{{- end -}}
{{- range $names }}export {{ . }}={{ keyring "dotfiles-env" . | shellQuote }}
{{ end -}}
