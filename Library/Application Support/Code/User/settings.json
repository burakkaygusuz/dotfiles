{
  // --- Font & Editor Appearance ---
  "editor.fontFamily": "'CommitMono Nerd Font Mono','FiraCode Nerd Font Mono', 'GeistMono Nerd Font Mono','MesloLGS Nerd Font Mono', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": -0.4,
  "editor.fontWeight": "normal",
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.unicodeHighlight.allowedLocales": {
    "tr": true
  },
  // --- Modern UI & Productivity ---
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.renderWhitespace": "selection",
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.linkedEditing": true,
  "editor.autoClosingBrackets": "languageDefined",
  "workbench.activityBar.location": "top",
  "workbench.list.smoothScrolling": true,
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.sideBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.defaultBinaryEditor": "default",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "window.commandCenter": true,
  "search.searchView.semanticSearchBehavior": "manual",
  // --- File Handling & Formatting ---
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  // --- Terminal ---
  "terminal.integrated.fontFamily": "'MesloLGS Nerd Font Mono', 'FiraCode Nerd Font Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontWeightBold": "bold",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.initialHint": false,
  "terminal.external.osxExec": "Terminal.app",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": [
        "-l"
      ],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "zsh",
      "args": [
        "-l"
      ]
    },
    "fish": {
      "path": "fish",
      "args": [
        "-l"
      ]
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop"
  ],
  // --- Git ---
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.promptToSaveFilesBeforeCommit": "always",
  "git.autoStash": true,
  "git.openRepositoryInParentFolders": "always",
  // --- Languages (JS/TS, Python, .NET) ---
  "js/ts.suggest.autoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "python.defaultInterpreterPath": "python3",
  "python.createEnvironment.trigger": "off",
  "python.languageServer": "Default",
  "yaml.schemas": {
    "https://raw.githubusercontent.com/microsoft/docs-yaml/main/schemas/toc.schema.json": "toc.yml"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  // --- Privacy, Updates & Telemetry ---
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "sonarlint.disableTelemetry": true,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "update.mode": "default",
  "extensions.autoUpdate": "on",
  // --- Tools & Code Quality ---
  "prettier.singleQuote": true,
  "prettier.trailingComma": "none",
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,
  "prettier.semi": true,
  "prettier.arrowParens": "always",
  "prettier.endOfLine": "auto",
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.run": "onType",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "sonarlint.focusOnNewCode": true,
  "sonarlint.automaticAnalysis": true,
  "sonarlint.rules": {
    "typescript:S7785": {
      "level": "off"
    }
  },
  "playwright.showTrace": false,
  "playwright.reuseBrowser": true,
  // --- GitHub Copilot ---
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Format MUST always be: <type>(<scope>): <description>"
    },
    {
      "text": "Scope is MANDATORY for every commit, even for simple changes."
    },
    {
      "text": "NEVER include a body or footer. ONLY generate a single line."
    },
    {
      "text": "NEVER include breaking change indicators or descriptions."
    },
    {
      "text": "Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    },
    {
      "text": "Subject: Max 50 chars, imperative mood, no period, all lowercase except proper nouns"
    }
  ],
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "dockercompose": true
  },
  "chat.agent.maxRequests": 100,
  "chat.mcp.access": "all",
  "chat.mcp.gallery.enabled": true,
  "chat.tools.riskAssessment.enabled": true
}
